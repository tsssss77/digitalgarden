STYLE_SETTINGS_CSS=body.css-settings-manager { --font-ui-small: 16px; --font-ui-smaller: 14px; --h1-size: 1.75em; --h2-size: 1.625em; --h3-size: 1.5em; --h4-size: 1.375em; --h5-size: 1.25em; --h6-size: 1.125em; --cg-nt-item-icon-size: 15px; --cg-nt-item-padding-x: 0.3em; --cg-nt-item-padding-y: 0.3em; } body.theme-light.css-settings-manager { --ax1: #9B8BD5; } body.theme-dark.css-settings-manager { --ax1: #9B8BD5; }
STYLE_SETTINGS_BODY_CLASSES=mod-linux is-mobile is-android is-phone obsidian-app styled-scrollbars theme-light show-inline-title show-ribbon show-view-header css-settings-manager minimal-theme minimal-nord-light minimal-nord-dark minimal-readable-off minimal-light minimal-dark colorful-headings links-int-on links-ext-on full-width-media minimal-folding chart-default-width table-default-width img-default-width iframe-default-width map-default-width callouts-default trim-cols checkbox-circle pdf-seamless-on pdf-invert-dark pdf-blend-light sidebar-tabs-default tab-names-off vault-profile-default ribbon-hidden maximize-tables-off tabs-default tab-stack-top minimal-tab-title-hover default
USE_FULL_RESOLUTION_IMAGES=false
THEME=https://raw.githubusercontent.com/aaaaalexis/obsidian-baseline/HEAD/theme.css
BASE_THEME=light
dgHomeLink=true
dgPassFrontmatter=false
dgShowBacklinks=false
dgShowLocalGraph=false
dgShowInlineTitle=true
dgShowFileTree=true
dgEnableSearch=true
